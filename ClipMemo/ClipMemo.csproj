<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\clipmemo.ico</ApplicationIcon>
    <StartupObject>ClipMemo.Program</StartupObject>
    <AssemblyName>ClipMemo</AssemblyName>
    <RootNamespace>ClipMemo</RootNamespace>
    <Version>2.0.0</Version>
    <Description>Multi-item clipboard history for Windows (Gboard-style)</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\clipmemo.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Assets\clipmemo.ico" />
    <Content Include="Assets\clipmemo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Assets\clipmemo.png" />
  </ItemGroup>

</Project>
